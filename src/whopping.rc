#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION WHOPPING_VERSION_COMMAS
PRODUCTVERSION WHOPPING_VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904B0"
    BEGIN
      VALUE "CompanyName", "TekRant Gaming"
      VALUE "FileDescription", "The Whopping Recompilation Collection"
      VALUE "FileVersion", WHOPPING_VERSION
      VALUE "ProductName", "The Whopping Recompilation Collection"
      VALUE "ProductVersion", WHOPPING_VERSION
      VALUE "OriginalFilename", "whopping_launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1200
  END
END
