From 19612d5d73eb2777edb0363ef45f586d86026eef Mon Sep 17 00:00:00 2001
From: TekRantGaming <craigferels896@gmail.com>
Date: Sat, 31 Oct 2026 01:02:47 +0000
Subject: [PATCH] Linux: RenderDoc only when it is already in the process

CreateIfConnected loaded librenderdoc.so with a plain dlopen. That finds a
copy installed on the system, and loading it starts RenderDoc inside the game
with nobody attached: players with RenderDoc installed saw its "Capturing
Vulkan" overlay at the top of the screen. RenderDoc's own in application API
docs ask for RTLD_NOLOAD on Linux, which returns the library only if it is
already loaded.

The same change as King Kong's SDK patch 0050.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ui/renderdoc_api.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/ui/renderdoc_api.cpp b/src/ui/renderdoc_api.cpp
index e1a5287..fcfd916 100644
--- a/src/ui/renderdoc_api.cpp
+++ b/src/ui/renderdoc_api.cpp
@@ -12,6 +12,10 @@
 #include <rex/logging.h>
 #include <rex/ui/renderdoc_api.h>
 
+#if REX_PLATFORM_LINUX
+#include <dlfcn.h>
+#endif
+
 namespace rex {
 namespace ui {
 
@@ -25,6 +29,16 @@ std::unique_ptr<RenderDocAPI> RenderDocAPI::CreateIfConnected() {
 
   pRENDERDOC_GetAPI get_api = nullptr;
 
+#if REX_PLATFORM_LINUX
+  // dlopen finds an installed librenderdoc.so even when nobody attached RenderDoc, and loading it starts
+  // RenderDoc's capture layer and overlay inside the game. Only use a copy already in the process.
+  void* attached = dlopen(platform::lib_names::kRenderDoc, RTLD_NOW | RTLD_NOLOAD);
+  if (!attached) {
+    return nullptr;
+  }
+  dlclose(attached);
+#endif
+
   // Try to load the RenderDoc library. If RenderDoc is attached, the library
   // should already be loaded into the process and this will increment the
   // reference count. If not attached, the load will fail and we return nullptr.
-- 
