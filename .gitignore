# Build output and test runs
/build/
/runs/
/third_party/trg-launcher/build/
*.log
# What the launcher creates beside itself when it runs (it runs from build/ or runs/ here; games/ is the ports)
/cache/
/save-backups/
/whopping.txt
/install-test.txt
