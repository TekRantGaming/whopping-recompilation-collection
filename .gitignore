*.iso
*.xex
/mockups/
/dist/

# --- The games (games/<id>) ---
# Copyrighted game data and everything made from it: never commit.
*.iso
*.xex
/games/*/assets/
/games/*/image.bin
/games/*/generated/
# Build output, logs and codegen scratch.
/games/*/out/
/games/*/missing_funcs.all.toml
/games/*/codegen.log
/games/*/build*.log
# The ReXGlue SDK install (a junction to the patched SDK, see BUILDING.md).
/tools/rexglue/
# Private notes, never in the repo
/OWNER.md
/DECISIONS.md
/ref/
